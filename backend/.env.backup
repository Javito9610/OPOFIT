# Obténlo en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=997698298685-blc1ifp4sflp40iitsn2c1b56t22k8d7.apps.googleusercontent.com

# === Firebase Admin (para verificar Firebase ID tokens) ===
FIREBASE_SERVICE_ACCOUNT_PATH=C:\\Proyecto_TFG\\keys\\miapp-opofit-7088e-firebase-adminsdk-fbsvc-695489996d.json

# === Integraciones con relojes (OAuth) ===
# URL PUBLICA del backend (donde Strava/Polar redirigen tras autorizar).
# PRODUCCION (todos los usuarios de la app): usa la URL de Railway:
OAUTH_BASE_URL=https://opofit-production.up.railway.app
# Desarrollo local:
# OAUTH_BASE_URL=http://localhost:3000
# Emulador Android: http://10.0.2.2:3000

# Strava: crea una app en https://www.strava.com/settings/api
# El "Authorization Callback Domain" debe ser el HOST de OAUTH_BASE_URL (sin http:// ni puerto).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Polar AccessLink: crea una app en https://admin.polaraccesslink.com/
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=

